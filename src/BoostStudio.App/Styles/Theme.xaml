<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════
         Boost Studio design tokens
         A restrained midnight palette with teal and violet signal accents.
         ══════════════════════════════════════════════════════════════════ -->

    <Color x:Key="BgColor">#080C11</Color>
    <Color x:Key="SurfaceColor">#0F1720</Color>
    <Color x:Key="SurfaceAltColor">#111C26</Color>
    <Color x:Key="SurfaceRaisedColor">#16232E</Color>
    <Color x:Key="CardColor">#0F1822</Color>
    <Color x:Key="BorderColor">#1D2C39</Color>
    <Color x:Key="BorderStrongColor">#2A3D4D</Color>
    <Color x:Key="TextPrimaryColor">#EEF4FA</Color>
    <Color x:Key="TextSecondaryColor">#9DB1C4</Color>
    <Color x:Key="TextMutedColor">#63788C</Color>
    <Color x:Key="AccentColor">#35E0C3</Color>
    <Color x:Key="AccentDeepColor">#17BFA6</Color>
    <Color x:Key="VioletColor">#8B5CF6</Color>
    <Color x:Key="BlueColor">#38BDF8</Color>
    <Color x:Key="WarningColor">#F5C95D</Color>
    <Color x:Key="DangerColor">#F97066</Color>
    <Color x:Key="SuccessColor">#4ADE80</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="#182631" />
    <SolidColorBrush x:Key="TrackFillBrush" Color="#223745" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#0A1017" />

    <LinearGradientBrush x:Key="TealGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#57F2DA" Offset="0" />
        <GradientStop Color="#20CBB3" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VioletGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B79CFF" Offset="0" />
        <GradientStop Color="#7C4DEE" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7FD8FF" Offset="0" />
        <GradientStop Color="#2E9FD8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BassGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C4A7FF" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#172730" Offset="0" />
        <GradientStop Color="#11202A" Offset="0.48" />
        <GradientStop Color="#0D171F" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#111D27" Offset="0" />
        <GradientStop Color="#0D151D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0C131A" Offset="0" />
        <GradientStop Color="#080D12" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardSheenGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#14313B" Offset="0" />
        <GradientStop Color="#101B25" Offset="0.45" />
        <GradientStop Color="#0E161E" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="HeroGlowBrush" Center="0.82,0.18" GradientOrigin="0.82,0.18" RadiusX="0.7" RadiusY="0.85">
        <GradientStop Color="#2835E0C3" Offset="0" />
        <GradientStop Color="#102D8A82" Offset="0.45" />
        <GradientStop Color="#0035E0C3" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="VioletGlowBrush" Center="0.9,0.15" GradientOrigin="0.9,0.15" RadiusX="0.75" RadiusY="0.8">
        <GradientStop Color="#2E8B5CF6" Offset="0" />
        <GradientStop Color="#0C8B5CF6" Offset="0.55" />
        <GradientStop Color="#008B5CF6" Offset="1" />
    </RadialGradientBrush>

    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="22" ShadowDepth="5"
                      Direction="270" Opacity="0.32" />
    <DropShadowEffect x:Key="SoftGlow" Color="#35E0C3" BlurRadius="20" ShadowDepth="0"
                      Direction="0" Opacity="0.35" />
    <DropShadowEffect x:Key="DialogShadow" Color="#000000" BlurRadius="38" ShadowDepth="12"
                      Direction="270" Opacity="0.55" />

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- ══════════════════════════════════════════════════════════════════
         Typography
         Foreground is intentionally inherited so list items and buttons can
         drive colour through the logical tree.
         ══════════════════════════════════════════════════════════════════ -->

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="H1" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="31" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="H2" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="H3" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BodyStrong" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="Secondary" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style x:Key="Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MonoText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style x:Key="IconGlyph" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BigGlyph" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconGlyph}">
        <Setter Property="FontSize" Value="21" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════
         Surfaces
         ══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource CardGradient}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="CardTight" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style x:Key="CardHover" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InnerCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#0B141C" />
        <Setter Property="BorderBrush" Value="#1A2935" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="15" />
    </Style>

    <Style x:Key="MetricTile" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#0C151D" />
        <Setter Property="BorderBrush" Value="#192833" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="StatusPill" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#0D1A22" />
        <Setter Property="BorderBrush" Value="#213541" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconBadge" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="#13232D" />
        <Setter Property="BorderBrush" Value="#203541" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Divider" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="Margin" Value="0,16" />
    </Style>

    <Style x:Key="TinyDivider" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="Margin" Value="6,0" />
    </Style>

</ResourceDictionary>
