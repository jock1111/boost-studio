<UserControl x:Class="BoostStudio.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BoostStudio.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ProfilesViewModel}"
             d:DesignWidth="1100"
             Foreground="{StaticResource TextPrimaryBrush}">
    <StackPanel>

        <!-- Header -->
        <Border CornerRadius="18" BorderBrush="#254A46" BorderThickness="1" Padding="26,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#102A28" Offset="0" />
                    <GradientStop Color="#101D25" Offset="0.55" />
                    <GradientStop Color="#0D151D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="310" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource IconBadge}" Width="54" Height="54" CornerRadius="15"
                        Background="#0E2B28" BorderBrush="#27564F">
                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,25,0" VerticalAlignment="Center">
                    <TextBlock Text="Sound profiles" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                               TextWrapping="Wrap" MaxWidth="590"
                               Text="Save a complete Bass, Volume, EQ and master setup, then switch to it in one click. Your device routing, hotkeys and application preferences are never changed." />
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource InnerCard}" Background="#0B191A"
                        BorderBrush="#234744" Padding="16,13">
                    <StackPanel>
                        <TextBlock Text="CURRENT SETUP" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding CurrentSetupSummary}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="#A5F3EA" Margin="0,5,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrentSetupDetail}" Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                        <Button Content="Save current setup" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCurrentCommand}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Height="32" Padding="12,0"
                                ToolTip="Save the current Bass, Volume, EQ and master state as a reusable profile" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Profile list + actions -->
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Your profiles" Style="{StaticResource H3}" />
                            <TextBlock Text="Select a profile to apply or manage it. The active profile is marked below."
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusPill}" Padding="9,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveProfileText}" FontSize="9.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,13,0,0">
                        <ListBox Style="{StaticResource PresetListBox}" MinHeight="190" MaxHeight="390"
                                 ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconBadge}" Width="34" Height="34"
                                                Background="#101E26" BorderBrush="#24404A">
                                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,1"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ACTIVE" FontSize="8" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Margin="5,0,0,0" Padding="6,1"
                                                        Background="#2B2314" BorderBrush="#5E4A24"
                                                        Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="MODIFIED" FontSize="8" FontWeight="SemiBold"
                                                               Foreground="#E9D49F" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="10.5" Margin="0,3,0,0"
                                                       Opacity="0.72" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            <TextBlock Text="{Binding UpdatedText}" FontSize="9" Margin="0,2,0,0"
                                                       Opacity="0.48"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="9.5"
                                                   VerticalAlignment="Center" Opacity="0.64"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <Border Background="#0A1219" BorderBrush="#182732" BorderThickness="1"
                                CornerRadius="10" Padding="24,28"
                                Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No profiles yet" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Text="Tune Bass, Volume and EQ the way you like, then save the setup here."
                                           Style="{StaticResource Caption}" TextAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="360" Margin="0,5,0,0" />
                                <Button Content="Save current setup" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SaveCurrentCommand}" HorizontalAlignment="Center"
                                        Margin="0,14,0,0" Height="34" Padding="14,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,14,0,11" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="A profile stores the master switch, auto headroom, all Bass and Volume parameters, and the full ten-band EQ curve. Applying one never changes your output device, monitoring device, hotkeys or startup options." />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Profile actions" Style="{StaticResource H3}" />
                    <TextBlock Text="{Binding SelectedProfileDetail}" Style="{StaticResource Caption}"
                               Margin="0,4,0,0" TextWrapping="Wrap" MinHeight="30" />

                    <Button Content="Apply selected profile" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ApplyCommand}" HorizontalAlignment="Stretch"
                            Margin="0,15,0,0" Height="38"
                            ToolTip="Load this profile into the live audio engine" />
                    <Button Content="Update from current setup" Style="{StaticResource SecondaryButton}"
                            Command="{Binding UpdateCommand}" HorizontalAlignment="Stretch"
                            Margin="0,8,0,0" Height="36"
                            ToolTip="Replace the selected profile with the current live settings" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Rename" Style="{StaticResource SubtleButton}"
                                Command="{Binding RenameCommand}" Margin="0,0,4,0" Height="34" />
                        <Button Grid.Column="1" Content="Delete" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteCommand}" Margin="4,0,0,0" Height="34" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,14,0,11" />

                    <Button Content="Undo last profile change" Style="{StaticResource SubtleButton}"
                            Command="{Binding UndoCommand}" HorizontalAlignment="Stretch" Height="34"
                            ToolTip="Restore the setup that was live before the last profile apply" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,9,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Help -->
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="How switching works" Style="{StaticResource H3}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Applying a profile writes a new DSP configuration through Equalizer APO, so every Windows application hears the change immediately. The previous setup is kept for the duration of this app session, which makes Undo a safe way to compare two profiles." />
                    <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                        <Button Content="Open Bass Booster" Style="{StaticResource SubtleButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="bass" Margin="0,0,6,0" />
                        <Button Content="Open Volume Booster" Style="{StaticResource SubtleButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="volume" Margin="0,0,6,0" />
                        <Button Content="Open Equalizer" Style="{StaticResource SubtleButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="equalizer" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource InnerCard}" Padding="18"
                    Background="#101A14" BorderBrush="#29412A">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Saved locally" FontSize="11.5" FontWeight="SemiBold"
                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap"
                               Text="Profiles are stored in your Boost Studio data folder and are included in Settings → Backup. They are not tied to an Equalizer APO installation, so they survive app updates." />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,7,0,0" TextWrapping="Wrap"
                               Text="Profile switching is not a sample-accurate crossfade: audio can briefly drop while Equalizer APO reloads the configuration." />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
