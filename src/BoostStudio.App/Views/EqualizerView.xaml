<UserControl x:Class="BoostStudio.App.Views.EqualizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BoostStudio.App.Controls"
             xmlns:vm="clr-namespace:BoostStudio.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:EqualizerViewModel}"
             d:DesignWidth="1100"
             Foreground="{StaticResource TextPrimaryBrush}">
    <StackPanel>

        <!-- Module header -->
        <Border CornerRadius="18" BorderBrush="#234A45" BorderThickness="1" Padding="26,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#102A28" Offset="0" />
                    <GradientStop Color="#0F1E23" Offset="0.55" />
                    <GradientStop Color="#0D151C" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="265" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource IconBadge}" Width="54" Height="54" CornerRadius="15"
                        Background="#0E2B28" BorderBrush="#27564F">
                    <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,25,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Equalizer" Style="{StaticResource H2}" />
                        <Border Style="{StaticResource StatusPill}" Margin="11,0,0,0" Padding="9,3"
                                Background="#102926" BorderBrush="#2A5852">
                            <TextBlock Text="{Binding ActiveLabel}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#A5F3EA" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}"
                               Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="620" />
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource InnerCard}" Background="#0B191A"
                        BorderBrush="#234744" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE SHAPE" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding BandSummary}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="20" FontWeight="SemiBold" Foreground="#A5F3EA"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding UserPresetCountText}" Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="14,0,0,0"
                                  ToolTip="Enable or bypass the equalizer" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Curve and preset toolbar -->
        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Response curve" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding PresetDescription}" Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Width="230" Height="38"
                                  ItemsSource="{Binding PresetChoices}"
                                  SelectedItem="{Binding SelectedPresetChoice, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  ToolTip="Built-in and user equalizer curves" />
                        <Button Content="Save" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SavePresetCommand}" Margin="8,0,0,0"
                                Height="36" Padding="13,0" ToolTip="Save the current curve as a user preset" />
                        <Button Content="Rename" Style="{StaticResource SubtleButton}"
                                Command="{Binding RenamePresetCommand}" Margin="6,0,0,0"
                                Height="36" ToolTip="Rename the selected user preset" />
                        <Button Content="Delete" Style="{StaticResource SubtleButton}"
                                Command="{Binding DeletePresetCommand}" Margin="6,0,0,0"
                                Height="36" ToolTip="Delete the selected user preset" />
                        <Button Content="Flatten" Style="{StaticResource SubtleButton}"
                                Command="{Binding FlatCommand}" Margin="6,0,0,0"
                                Height="36" ToolTip="Reset every band to 0 dB" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource InnerCard}" Padding="12,8" Margin="0,14,0,0"
                        Background="#0A1218" BorderBrush="#20333C">
                    <controls:ResponseCurve Height="206"
                                            Values="{Binding Response}"
                                            LiveBars="{Binding Monitor.BassLevels}"
                                            MinFrequency="20" MaxFrequency="20000"
                                            MinDb="-13" MaxDb="13"
                                            Accent="{StaticResource AccentBrush}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Ten bands -->
        <Border Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Ten ISO octave bands" Style="{StaticResource H3}" />
                        <TextBlock Text="Drag a band, use the arrow keys, or double-click to return it to 0 dB. Each band is a peaking filter with Q 1.41."
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatusPill}" Padding="10,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="−12 dB  ·  0  ·  +12 dB" FontSize="9.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </Grid>

                <Border Style="{StaticResource InnerCard}" Margin="0,14,0,0" Padding="10,8"
                        Background="#0A1218" BorderBrush="#20333C">
                    <ItemsControl ItemsSource="{Binding Bands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:EqBandSlider Height="242" Margin="2,0"
                                                       Minimum="-12" Maximum="12" Step="0.5"
                                                       BandLabel="{Binding Label}"
                                                       Value="{Binding Value, Mode=TwoWay}"
                                                       Accent="{StaticResource AccentBrush}"
                                                       ToolTip="{Binding FrequencyText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                                   Margin="7,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedPresetName}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Preset workflow + notes -->
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Preset workflow" Style="{StaticResource H3}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Choose a built-in curve for a starting point, shape the ten bands, then save the result under your own name. User presets live in your local Boost Studio data folder and are included in backups." />
                    <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                        <Button Content="Save current curve" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SavePresetCommand}" Height="34" Padding="13,0"
                                Margin="0,0,6,0" />
                        <Button Content="Reset all bands" Style="{StaticResource SubtleButton}"
                                Command="{Binding FlatCommand}" Height="34" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="What you are seeing" Style="{StaticResource H3}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="The line is the exact summed magnitude response of the ten peaking biquads written to Equalizer APO. The shaded bass bars are live measured energy from the real loopback signal, not a simulated animation." />
                    <Border Style="{StaticResource Divider}" Margin="0,12,0,9" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Positive boost consumes headroom automatically. If the output clip warning appears, cut a broad region instead of only lowering one band." />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
