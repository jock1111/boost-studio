<Window x:Class="BoostStudio.App.Views.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boost Studio"
        Width="520" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Border CornerRadius="18" Background="{StaticResource CardGradient}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                Effect="{StaticResource DialogShadow}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Height="3" CornerRadius="18,18,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#35E0C3" Offset="0.45" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Grid.Row="1" Margin="24,20,18,0"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12"
                            Background="#1D2B3A" BorderBrush="#35485C" BorderThickness="1">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource VioletBrush}" />
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="Enter a value"
                               FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                               Margin="13,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                            Width="32" Height="32" Click="Cancel_Click" ToolTip="Close" />
                </Grid>

                <StackPanel Grid.Row="2" Margin="24,18,24,0">
                    <TextBlock x:Name="MessageText" Text="Message"
                               Style="{StaticResource Secondary}" FontSize="12.5"
                               TextWrapping="Wrap" LineHeight="19" />
                    <TextBlock x:Name="FieldLabel" Text="Name" Margin="0,16,0,7"
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="ValueBox" MinHeight="40" />
                    <TextBlock x:Name="HelpText" Style="{StaticResource Secondary}" Foreground="{StaticResource TextMutedBrush}"
                               Margin="2,7,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="11.5"
                               Margin="2,7,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Click="Cancel_Click" MinWidth="92" Margin="0,0,8,0" />
                        <Button Content="Save" Style="{StaticResource PrimaryButton}"
                                Click="Confirm_Click" MinWidth="104" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
