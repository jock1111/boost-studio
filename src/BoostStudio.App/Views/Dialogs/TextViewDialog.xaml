<Window x:Class="BoostStudio.App.Views.Dialogs.TextViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boost Studio"
        Width="720" Height="580" MinWidth="520" MinHeight="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Border CornerRadius="18" Background="{StaticResource CardGradient}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                Effect="{StaticResource DialogShadow}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Height="3" CornerRadius="18,18,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#35E0C3" Offset="0.45" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Grid.Row="1" Margin="24,20,18,0"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12"
                            Background="#142630" BorderBrush="#29404E" BorderThickness="1">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="Details"
                               FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                               Margin="13,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                            Width="32" Height="32" Click="Close_Click" ToolTip="Close" />
                </Grid>

                <Grid Grid.Row="2" Margin="24,14,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="MessageText" Text="Details"
                               Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap"
                               LineHeight="18" />
                    <Border Grid.Row="1" Style="{StaticResource InnerCard}" Margin="0,12,0,0"
                            Padding="2" Background="#070C11">
                        <TextBox x:Name="ContentBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" BorderThickness="0" Background="Transparent"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                 Padding="12,10" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="24,18,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />
                    <Grid Grid.Row="1">
                        <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" MinWidth="92" Click="Copy_Click" />
                        <Button Content="Close" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" MinWidth="104" Click="Close_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
