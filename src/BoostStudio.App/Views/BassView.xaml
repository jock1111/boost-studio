<UserControl x:Class="BoostStudio.App.Views.BassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BoostStudio.App.Controls"
             xmlns:vm="clr-namespace:BoostStudio.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:BassBoosterViewModel}"
             d:DesignWidth="1100"
             Foreground="{StaticResource TextPrimaryBrush}">
    <StackPanel>

        <!-- Module header -->
        <Border CornerRadius="18" BorderBrush="#332C4C" BorderThickness="1" Padding="26,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1B1930" Offset="0" />
                    <GradientStop Color="#121725" Offset="0.55" />
                    <GradientStop Color="#0E151E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource IconBadge}" Width="54" Height="54" CornerRadius="15"
                        Background="#201A38" BorderBrush="#45346A">
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                               Foreground="{StaticResource VioletBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,25,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bass Booster" Style="{StaticResource H2}" />
                        <Border Style="{StaticResource StatusPill}" Margin="11,0,0,0" Padding="9,3"
                                Background="#1B1730" BorderBrush="#3D315E">
                            <TextBlock Text="{Binding ActiveLabel}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#CDB9FF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}"
                               Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="620" />
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource InnerCard}" Background="#100D1C"
                        BorderBrush="#352A51" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LOW-SHELF GAIN" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding GainText}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="25" FontWeight="SemiBold" Foreground="#D6C6FF"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding FrequencyText}" Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="14,0,0,0"
                                  ToolTip="Enable or bypass Bass Booster" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Tuning + presets -->
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.62*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Shelf response &amp; tuning" Style="{StaticResource H3}" />
                            <TextBlock Text="Drag a knob vertically or use the mouse wheel. Double-click resets it."
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reset tuning" Style="{StaticResource SubtleButton}"
                                Command="{Binding ResetCommand}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource InnerCard}" Padding="12,8" Margin="0,14,0,0"
                            Background="#0B101A" BorderBrush="#292441">
                        <controls:ResponseCurve Height="140"
                                                Values="{Binding Response}"
                                                LiveBars="{Binding Monitor.BassLevels}"
                                                MinFrequency="20" MaxFrequency="320"
                                                MinDb="-2" MaxDb="26"
                                                Accent="{StaticResource VioletBrush}" />
                    </Border>

                    <UniformGrid Columns="4" Margin="0,17,0,0">
                        <StackPanel Margin="4,0">
                            <controls:Knob Height="146" Value="{Binding Intensity, Mode=TwoWay}"
                                           Minimum="0" Maximum="100" Step="1"
                                           ResetValue="45" Title="Intensity" Suffix="%"
                                           Accent="{StaticResource VioletBrush}"
                                           IsActive="{Binding Enabled}"
                                           ToolTip="How much of the maximum shelf gain is applied" />
                            <TextBlock Text="0 – 100%" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <controls:Knob Height="146" Value="{Binding FrequencyHz, Mode=TwoWay}"
                                           Minimum="20" Maximum="250" Step="1"
                                           ResetValue="80" Title="Corner" Suffix=" Hz" ValueFormat="0"
                                           Accent="{StaticResource VioletBrush}"
                                           IsActive="{Binding Enabled}"
                                           ToolTip="Low-shelf corner frequency" />
                            <TextBlock Text="20 – 250 Hz" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <controls:Knob Height="146" Value="{Binding MaxGainDb, Mode=TwoWay}"
                                           Minimum="0" Maximum="24" Step="0.5"
                                           ResetValue="18" Title="Max gain" Suffix=" dB" ValueFormat="0.0"
                                           Accent="{StaticResource VioletBrush}"
                                           IsActive="{Binding Enabled}"
                                           ToolTip="Maximum low-shelf gain at 100% intensity" />
                            <TextBlock Text="0 – 24 dB" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <controls:Knob Height="146" Value="{Binding ShelfQ, Mode=TwoWay}"
                                           Minimum="0.30" Maximum="1.40" Step="0.01"
                                           ResetValue="0.707" Title="Shelf Q" ValueFormat="0.00"
                                           Accent="{StaticResource VioletBrush}"
                                           IsActive="{Binding Enabled}"
                                           ToolTip="Lower values are broader; higher values add upper-bass bite" />
                            <TextBlock Text="0.30 – 1.40" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Bass presets" Style="{StaticResource H3}" />
                            <TextBlock Text="Start from a character, then fine-tune."
                                       Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="5 CURVES" Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ListBox Style="{StaticResource PresetListBox}" Margin="0,13,0,0"
                             ItemsSource="{Binding Presets}"
                             SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ShortName}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        <TextBlock Text="{Binding Description}" FontSize="9.8" Margin="0,2,0,0"
                                                   Opacity="0.62" TextWrapping="Wrap" MaxHeight="28"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Intensity, StringFormat={}{0}%}"
                                                   FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        <TextBlock Text="{Binding FrequencyHz, StringFormat={}{0:0} Hz}"
                                                   FontSize="9" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                   Opacity="0.55"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource Divider}" Margin="0,13,0,10" />
                    <TextBlock Text="Auto headroom reserves the maximum possible shelf gain so strong curves do not push the output into hard clipping. Extreme Bass intentionally uses the full 24 dB range."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Live analysis + test tone -->
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Live bass energy" Style="{StaticResource H3}" />
                            <TextBlock Text="{Binding Monitor.StatusText}" Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusPill}" Padding="9,4">
                            <TextBlock Text="20 – 250 HZ" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <controls:SpectrumDisplay Height="126" Margin="0,12,0,0"
                                              Values="{Binding Monitor.BassLevels}"
                                              Active="{Binding Monitor.IsActive}"
                                              HighlightBass="False"
                                              MinFrequency="20" MaxFrequency="250" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DOMINANT BASS" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding Monitor.DominantBassText}" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="OUTPUT PEAK" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding Monitor.PeakText}" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BASS SHAPING" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Listen to the change" Style="{StaticResource H3}" />
                    <TextBlock Text="{Binding TestTone.StatusText}" Style="{StaticResource Caption}"
                               Margin="0,3,0,0" TextWrapping="Wrap" />
                    <Button Content="{Binding TestTone.PlayButtonText}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding TestTone.PlayBassCommand}" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Height="36"
                            ToolTip="Play a 60 Hz tone through Windows shared-mode output" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Level tone" Style="{StaticResource SubtleButton}"
                                Command="{Binding TestTone.PlayLevelCommand}" Margin="0,0,6,0" />
                        <Button Content="Sweep" Style="{StaticResource SubtleButton}"
                                Command="{Binding TestTone.PlaySweepCommand}" Margin="0,0,6,0" />
                        <Button Content="Stop" Style="{StaticResource SubtleButton}"
                                Command="{Binding TestTone.StopCommand}" />
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" Margin="0,14,0,11" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="Bass is applied with Equalizer APO's low-shelf filter. Headphones and small speakers may not reproduce the lowest presets; use the dominant-bass readout to confirm what is actually present." />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
