<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Boost Studio"
           Manufacturer="Boost Studio"
           Version="1.1.1"
           UpgradeCode="8197980B-D768-4F0E-9FB3-EB1F8AB80ECF"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="Boost Studio system-wide bass, volume and equalizer processing"
                        Manufacturer="Boost Studio" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Boost Studio is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="BoostStudioIcon" SourceFile="src\BoostStudio.App\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="BoostStudioIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Per-user installation: no administrator prompt is required to install the app.
         Boost Studio asks for elevation only when the user chooses to grant Equalizer APO
         config access or enable an APO. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Boost Studio" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Boost Studio" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Boost Studio" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="BoostStudioExe"
              Source="artifacts\publish-x64\BoostStudio.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="Boost Studio"
                  Description="System-wide bass, volume and equalizer processing"
                  Target="[INSTALLFOLDER]BoostStudio.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\BoostStudio"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
